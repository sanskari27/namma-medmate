# Copy to scripts/clone-prod-db.env (gitignored). Never commit passwords.
# Start tunnel first: make db-tunnel

CONTAINER_RUNTIME=docker

# Via SSM tunnel (make db-tunnel) — prod RDS read-only
PROD_DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/nammamedmate
PROD_PG_USER=nammamedmate
PROD_PG_PASSWORD=

LOCAL_DATABASE_URL=jdbc:postgresql://127.0.0.1:25432/nammamedmate
LOCAL_PG_USER=postgres
LOCAL_PG_PASSWORD=postgres

# Optional: SOURCE=s3 restore from latest dump
# S3_DUMP_BUCKET=namma-medmate-db-dumps
