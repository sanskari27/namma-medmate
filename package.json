{
  "name": "@namma-medmate/source",
  "version": "0.0.0",
  "private": true,
  "description": "Namma MedMate TypeScript monorepo",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "nx run-many -t lint --all",
    "typecheck": "nx run-many -t typecheck --all",
    "test": "nx run-many -t test --all",
    "test:coverage": "nx run-many -t test --all --configuration=coverage",
    "build": "nx run-many -t build --all",
    "boundaries": "nx run boundaries:validate",
    "codegen": "nx run contracts:codegen",
    "codegen:check": "nx run contracts:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local:up": "pnpm --filter @namma-medmate/local-dev run up",
    "local:down": "pnpm --filter @namma-medmate/local-dev run down",
    "graph": "nx graph"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.32.0",
    "@nx/esbuild": "^21.4.1",
    "@nx/eslint": "^21.4.1",
    "@nx/eslint-plugin": "^21.4.1",
    "@nx/js": "^21.4.1",
    "@nx/playwright": "^21.4.1",
    "@nx/react": "^21.4.1",
    "@nx/vite": "^21.4.1",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.2",
    "@aws-sdk/client-ssm": "^3.864.0",
    "@lhci/cli": "^0.14.0",
    "@reduxjs/toolkit": "^2.8.2",
    "js-yaml": "^4.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "nx": "^21.4.1",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "nx"
    ]
  }
}
