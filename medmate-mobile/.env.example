# ---- App environment -------------------------------------------------------
# `development` | `staging` | `production`
APP_ENV=development

# Base URL of the MedMate API. Leave blank while the app runs on mock data.
EXPO_PUBLIC_API_BASE_URL=

# Set to `false` to talk to the real API. The mock layer stays on while this
# is `true`, or while no base URL is configured — so the app always has
# something to render.
EXPO_PUBLIC_USE_MOCK_API=true

# Analytics / crash reporting SDK keys (added when the backend lands)
EXPO_PUBLIC_SENTRY_DSN=
