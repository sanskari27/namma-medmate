# Production compose .env is written at deploy time from SSM, not copied by hand.
# Parameter: /namma-medmate-prod/compose.env
# Pull: ./scripts/pull-prod-env.sh .env
# Change keys: GitHub Action "Prod env (SSM)" or ./scripts/update-prod-env.sh
#
# The pharmacy service reads DATABASE_URL, AWS_REGION, COGNITO_USER_POOL_ID,
# COGNITO_CLIENT_ID, COGNITO_CLIENT_SECRET, and S3_BUCKET from this file.

WEBSITE_SITE_URL=https://medmatepharmacy.com
NEXT_PUBLIC_API_BASE_URL=https://api.nammamedmate.com
NEXT_PUBLIC_PHARMACY_URL=https://pharmacy.nammamedmate.com
DATABASE_URL=postgres://pharmacy:pharmacy@127.0.0.1:5432/pharmacy
MASTER_PHONES=
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
S3_BUCKET=
