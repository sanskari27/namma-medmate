# Production compose .env is written at deploy time from SSM, not copied by hand.
# Parameter: /namma-medmate-prod/compose.env
# Pull: ./scripts/pull-prod-env.sh .env
# Change keys: GitHub Action "Prod env (SSM)" or ./scripts/update-prod-env.sh
#
# First terraform apply seeds RDS/Redis/JWT. Later applies do not overwrite SSM.
# Add Resend keys with the workflow (set RESEND_API_KEY / RESEND_WEBHOOK_SECRET).
# Add Cashfree keys with the workflow (set CASHFREE_CLIENT_ID / CASHFREE_CLIENT_SECRET / CASHFREE_WEBHOOK_SECRET).

DATABASE_URL=jdbc:postgresql://REPLACE_RDS_ENDPOINT:5432/nammamedmate
DATABASE_USERNAME=nammamedmate
DATABASE_PASSWORD=
REDIS_HOST=REPLACE_ELASTICACHE_ENDPOINT
REDIS_PORT=6379
JWT_SECRET=
SPRING_PROFILES_ACTIVE=prod
PUBLIC_BASE_URL=https://api.nammamedmate.com
CORS_ALLOWED_ORIGINS=https://dispensary.nammamedmate.com,https://admin.nammamedmate.com
STORAGE_ROOT=/app/files
VITE_API_BASE_URL=https://api.nammamedmate.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM="Namma MedMate <noreply@nammamedmate.com>"
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_DISPLAY_NUMBER=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_RETURN_URL=https://dispensary.nammamedmate.com/subscription
